{
  "name": "safemotion-pwa",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "SafeMotion AI - PWA (Parcial 2: sensores, wearable simulado, comunicación con Spring Boot, chat médico y SOS)",
  "scripts": {
    "dev": "vite --host",
    "dev:https": "HTTPS=1 vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "test": "node --test tests/unit.test.js tests/chat.unit.test.js tests/sync.unit.test.js",
    "lint": "eslint .",
    "test:aut": "node --test tests/aut/unitarias.test.js",
    "test:aut:int": "node --test tests/aut/integracion.test.js",
    "test:aut:int:emulador": "npx -y firebase-tools@14 emulators:exec --only auth,firestore --project demo-safemotion \"bash tests/aut/ci-integracion.sh\"",
    "test:ci": "node --test tests/aut/unitarias.test.js tests/unit.test.js tests/chat.unit.test.js tests/sync.unit.test.js tests/blackbox.test.js tests/whitebox/wb.app.unit.test.js tests/p12.unit.test.js",
    "test:sync": "node --test tests/sync.unit.test.js",
    "test:sync:int": "node --test tests/sync.integration.test.js",
    "test:e2e:sync": "node tests/e2e.sync.mjs",
    "test:api": "node --test tests/integration.test.js tests/atencion.integration.test.js",
    "test:blackbox": "node --test tests/blackbox.test.js",
    "test:e2e": "node tests/e2e.blackbox.mjs",
    "test:e2e:chat": "node tests/e2e.chat.mjs",
    "test:firebase": "npx -y firebase-tools@14 emulators:exec --only auth,firestore --project demo-safemotion \"node --test tests/firebase.reglas.test.js\"",
    "test:firebase:real": "node --test tests/firebase.reglas.test.js",
    "test:e2e:firebase": "npx -y firebase-tools@14 emulators:exec --only auth,firestore --project demo-safemotion --ui \"node tests/e2e.firebase.mjs\"",
    "test:e2e:firebase:real": "node tests/e2e.firebase.mjs",
    "test:wb": "node --test tests/whitebox/wb.app.unit.test.js",
    "test:wb:cov": "node --test --experimental-test-coverage --test-coverage-include=src/models/measurement.js --test-coverage-include=src/services/activity.js --test-coverage-include=src/services/api.js --test-coverage-include=src/services/sync.js --test-coverage-include=src/services/auth.js tests/whitebox/wb.app.unit.test.js",
    "test:wb:api": "node tests/whitebox/wb.api.mjs",
    "test:wb:db": "node tests/whitebox/wb.db.mjs",
    "test:wb:rendimiento": "node tests/whitebox/wb.rendimiento.mjs",
    "test:wb:interrupcion": "node tests/whitebox/wb.interrupcion.mjs",
    "test:wb:ui": "node tests/whitebox/wb.ui.mjs",
    "test:p12": "node --test tests/p12.unit.test.js",
    "p12:preparar": "node tests/estres/preparar-emulador.mjs",
    "p12:estres": "node tests/estres/estres.mjs",
    "p12:db": "node tests/estres/db-avanzado.mjs",
    "p12:resiliencia": "node tests/estres/resiliencia.mjs",
    "p12:profiling": "node tests/estres/profiling-app.mjs"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "^1.1.0",
    "eslint": "^9.17.0",
    "fake-indexeddb": "^6.2.6",
    "puppeteer-core": "^23.11.1",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^0.20.5"
  },
  "dependencies": {
    "firebase": "^11.10.0"
  }
}
