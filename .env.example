# Firebase: con estas tres variables la app guarda y lee todo de Cloud Firestore (base compartida entre teléfonos).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=mesaayuda-a631d
VITE_FIREBASE_AUTH_DOMAIN=mesaayuda-a631d.firebaseapp.com
# Sin Firebase: URL del backend Spring Boot (sin /api al final). Ejemplo: http://localhost:8080
# Si también se deja vacía, la app usa el modo simulado con el mismo contrato.
VITE_API_URL=
